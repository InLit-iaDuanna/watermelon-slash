{
  "name": "watermelon-slash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AR-style hand-tracking watermelon slicing game for iPhone Safari",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "VITE_HTTPS=1 vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\""
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.18",
    "three": "0.171.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "0.171.0",
    "@vitest/coverage-v8": "^4.1.12",
    "playwright": "^1.65.0",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "vite": "7.3.8",
    "vite-plugin-mkcert": "1.17.6",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
